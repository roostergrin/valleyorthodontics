.base-image(:class=`{ 'base-image--bg': imageType === 'cover' }`)
  picture
    source(v-if='webp', :srcset='webp', type='image/webp')
    img.base-image__image(
      ref='image',
      :alt='alt',
      :aria-hidden=`imageBackground && !forceAlt ? 'true' : 'false'`,
      :class=`{ 'base-image__image--bg': imageType === 'cover' }`,
      :src='src',
      :style=`{ objectPosition: objectPosition }`,
      :loading='loadingAttribute',
      :fetchpriority='fetchPriority',
      decoding='async',
      @load='onLoad'
    )
  transition(name='fade-src-img')
    .base-image__overlay(v-if='showOverlay', :style=`{ backgroundColor: bgColor }`)
      svg.base-image__spinner(
        width='30px',
        height='30px',
        viewBox='0 0 66 66',
        v-if='addLoader'
      )
        circle.base-image__ring(
          cx='33',
          cy='33',
          r='30'
        )
